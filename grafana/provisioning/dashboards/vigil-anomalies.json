{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "time": { "from": "now-3h", "to": "now" },
  "refresh": "30s",
  "title": "Vigil — Anomalies",
  "uid": "vigil-anomalies",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "postgres" },
        "query": "SELECT DISTINCT host FROM metrics ORDER BY host",
        "refresh": 1,
        "includeAll": false
      },
      {
        "name": "metric",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "postgres" },
        "query": "SELECT DISTINCT name FROM metrics WHERE name NOT LIKE '%:avg' ORDER BY name",
        "refresh": 1,
        "current": { "text": "cpu_total_percent", "value": "cpu_total_percent" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Коридор нормы μ±3σ — $host / $metric",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "value" },
            "properties": [ { "id": "custom.lineWidth", "value": 2 }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] },
          { "matcher": { "id": "byRegexp", "options": "/upper|lower/" },
            "properties": [ { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 6] } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "postgres" },
          "format": "time_series",
          "rawSql": "SELECT ts AS time, value, avg(value) OVER w + 3*stddev_samp(value) OVER w AS upper, avg(value) OVER w - 3*stddev_samp(value) OVER w AS lower FROM metrics WHERE host = '$host' AND name = '$metric' AND $__timeFilter(ts) WINDOW w AS (ORDER BY ts ROWS BETWEEN 30 PRECEDING AND CURRENT ROW) ORDER BY ts"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Частота аномалий (rate)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "sum(rate(vigil_analyzer_anomalies_total[5m]))",
          "legendFormat": "аномалий/сек"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Аномалии по сериям (всего)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "sum by (host, metric) (vigil_analyzer_anomalies_total)",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Длительность прохода analyzer (p95)",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "histogram_quantile(0.95, sum(rate(vigil_analyzer_run_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
