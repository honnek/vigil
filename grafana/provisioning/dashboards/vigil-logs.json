{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "",
  "title": "Vigil — Logs",
  "uid": "vigil-logs",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Логи по уровням",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" }, "fillOpacity": 60 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "editorType": "sql",
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(timestamp) AS time, toString(level) AS level, count() AS count FROM vigil.logs WHERE $__timeFilter(timestamp) GROUP BY time, level ORDER BY time"
        }
      ]
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Ошибки по сервисам (ERROR)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "orientation": "horizontal", "legend": { "showLegend": false } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "editorType": "sql",
          "queryType": "table",
          "rawSql": "SELECT service, count() AS errors FROM vigil.logs WHERE level = 'ERROR' AND $__timeFilter(timestamp) GROUP BY service ORDER BY errors DESC"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Последние логи",
      "gridPos": { "h": 13, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "editorType": "sql",
          "queryType": "table",
          "rawSql": "SELECT timestamp, host, service, toString(level) AS level, message FROM vigil.logs WHERE $__timeFilter(timestamp) ORDER BY timestamp DESC LIMIT 200"
        }
      ]
    }
  ]
}
